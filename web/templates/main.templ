package templates

import (
	"github.com/gvillela7/usts/internal/repository"
	"github.com/gvillela7/usts/web/templates/pages"
	"github.com/gvillela7/usts/web/templates/components"
)

templ Layout(title string, currentPage string, project *repository.Project, metaTags, bodyContent templ.Component) {
	<!DOCTYPE html>
	<html lang="pt-BR" class="h-full">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta http-equiv="X-UA-Compatible" content="ie=edge"/>
			<meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' ws://localhost:*; img-src 'self' data:;"/>
			<meta name="theme-color" content="#4f46e5"/>
			<title>{ title }</title>
			@metaTags
			<link rel="dns-prefetch" href="//fonts.googleapis.com"/>
			<link rel="dns-prefetch" href="//fonts.gstatic.com"/>
			<link rel="preconnect" href="//fonts.googleapis.com" crossorigin/>
			<link rel="preconnect" href="//fonts.gstatic.com" crossorigin/>
			<link rel="manifest" href="/static/manifest.webmanifest"/>
			<link rel="apple-touch-icon" href="/static/apple-touch-icon.png"/>
			<link rel="shortcut icon" href="/static/favicon.ico" type="image/x-icon"/>
			<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
			<link rel="icon" href="/static/favicon.png" sizes="any"/>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
			<link href="/static/styles.css?v=oslayout4" rel="stylesheet"/>
			<style>
				.modal:is([open]) {
					pointer-events: auto;
					visibility: visible;
					opacity: 1;
				}
				.modal-box {
					max-width: 28rem;
					width: calc(100% - 2rem);
					margin: auto;
					transform: none;
				}
				.modal-backdrop {
					background-color: rgb(15 23 42 / 0.4);
				}
			</style>
		</head>
		<body class="min-h-full bg-slate-50 text-slate-800 antialiased" onload={ pages.BodyScripts() }>
			@components.Navbar(currentPage, project)
			<div class="lg:pl-60">
				@bodyContent
			</div>
			<script src="/static/scripts.js?v=oslayout11"></script>
		</body>
	</html>
}
