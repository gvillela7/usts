package catalogo

import (
	"fmt"
	"strings"
	"time"

	"github.com/gvillela7/usts/internal/repository"
)

type catalogGroup struct {
	Prefix string
	Name   string
	Items  []repository.Catalog
}

templ MetaTagsCatalogo(keywords, description string) {
	<meta name="keywords" content={ keywords }/>
	<meta name="description" content={ description }/>
}

templ CatalogoBodyContent(catalogs []repository.ServiceCatalog, project repository.Project) {
	<div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
		<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="text-xs font-semibold uppercase tracking-[0.14em] text-indigo-600">{ project.Name }</p>
				<h1 class="mt-1 text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl">Catálogo de Serviços</h1>
				<p class="mt-2 max-w-xl text-sm leading-relaxed text-slate-500">
					Catálogos deste projeto, com vigência e itens precificados em UST.
				</p>
			</div>
			<a
				href={ templ.URL(fmt.Sprintf("/catalogo/new?project_id=%d", project.ID)) }
				class="inline-flex items-center justify-center rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-medium text-white no-underline shadow-sm hover:bg-indigo-700"
			>
				Novo catálogo
			</a>
		</div>

		if len(catalogs) == 0 {
			<div class="rounded-xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center">
				<p class="text-sm font-medium text-slate-700">Este projeto ainda não tem catálogo.</p>
				<p class="mt-1 text-sm text-slate-500">Informe o nome, o período de vigência e depois inclua os itens.</p>
				<a href={ templ.URL(fmt.Sprintf("/catalogo/new?project_id=%d", project.ID)) } class="mt-4 inline-flex text-sm font-medium text-indigo-600 no-underline hover:text-indigo-800">Cadastrar catálogo</a>
			</div>
		} else {
			<div class="grid gap-4 sm:grid-cols-2">
				for _, catalog := range catalogs {
					<a
						href={ templ.URL(fmt.Sprintf("/catalogo/detail?id=%d", catalog.ID)) }
						class="block rounded-xl border border-slate-200 bg-white p-5 shadow-sm no-underline transition-colors hover:border-indigo-200 hover:bg-slate-50/80"
					>
						<div class="flex items-start justify-between gap-3">
							<h3 class="text-base font-semibold text-slate-900">{ catalog.Name }</h3>
							if catalog.IsActive(time.Now()) {
								<span class="shrink-0 rounded-full bg-emerald-50 px-2 py-0.5 text-[11px] font-medium text-emerald-700">Vigente</span>
							} else {
								<span class="shrink-0 rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-500">Fora do período</span>
							}
						</div>
						<p class="mt-2 text-sm text-slate-500">
							{ formatDate(catalog.StartDate) } — { formatDate(catalog.EndDate) }
						</p>
						<p class="mt-3 text-xs font-medium text-slate-400">{ itemCountLabel(catalog.ItemCount) }</p>
					</a>
				}
			</div>
		}
	</div>
}

templ CatalogoNewBodyContent(project repository.Project, hasTemplates bool, defaultStart, defaultEnd, errorMessage string) {
	<div class="mx-auto max-w-2xl px-4 py-8 sm:px-6 sm:py-10">
		<a href={ templ.URL(fmt.Sprintf("/catalogo?project_id=%d", project.ID)) } class="text-sm font-medium text-slate-500 no-underline hover:text-slate-800">← Voltar ao catálogo</a>
		<div class="mt-4">
			<p class="text-xs font-semibold uppercase tracking-[0.14em] text-indigo-600">{ project.Name }</p>
			<h1 class="mt-1 text-2xl font-semibold tracking-tight text-slate-900">Cadastrar catálogo</h1>
			<p class="mt-2 text-sm leading-relaxed text-slate-500">Informe o nome e o período de vigência. Depois você inclui os itens.</p>
		</div>

		if errorMessage != "" {
			<div class="mt-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{ errorMessage }</div>
		}

		<form action="/catalogs/create" method="POST" class="mt-6 space-y-5 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
			<input type="hidden" name="project_id" value={ fmt.Sprintf("%d", project.ID) }/>
			<div>
				<label class="mb-1.5 block text-sm font-medium text-slate-700">Projeto</label>
				<p class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-800">{ project.Name }</p>
			</div>
			<div>
				<label for="name" class="mb-1.5 block text-sm font-medium text-slate-700">Nome do catálogo</label>
				<input
					id="name"
					name="name"
					type="text"
					required
					placeholder="Ex.: Catálogo 2026"
					class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-800 shadow-sm outline-none placeholder:text-slate-400 focus:border-indigo-300 focus:ring-2 focus:ring-indigo-100"
				/>
			</div>
			<div class="grid gap-4 sm:grid-cols-2">
				<div>
					<label for="start_date" class="mb-1.5 block text-sm font-medium text-slate-700">Início da vigência</label>
					<input
						id="start_date"
						name="start_date"
						type="date"
						required
						value={ defaultStart }
						class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-800 shadow-sm outline-none focus:border-indigo-300 focus:ring-2 focus:ring-indigo-100"
					/>
				</div>
				<div>
					<label for="end_date" class="mb-1.5 block text-sm font-medium text-slate-700">Fim da vigência</label>
					<input
						id="end_date"
						name="end_date"
						type="date"
						required
						value={ defaultEnd }
						class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-800 shadow-sm outline-none focus:border-indigo-300 focus:ring-2 focus:ring-indigo-100"
					/>
				</div>
			</div>
			if hasTemplates {
				<label class="flex items-start gap-3 rounded-xl border border-slate-200 bg-slate-50/80 px-4 py-3">
					<input type="checkbox" name="copy_template" value="1" class="mt-1 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" checked/>
					<span>
						<span class="block text-sm font-medium text-slate-800">Copiar itens do modelo padrão</span>
						<span class="mt-0.5 block text-xs text-slate-500">Inclui os serviços oficiais (ARQ, COD, DAD…) para você ajustar depois.</span>
					</span>
				</label>
			}
			<div class="flex gap-3 pt-2">
				<a href={ templ.URL(fmt.Sprintf("/catalogo?project_id=%d", project.ID)) } class="flex-1 rounded-xl border border-slate-200 bg-white py-2.5 text-center text-sm font-medium text-slate-600 no-underline hover:bg-slate-50">Cancelar</a>
				<button type="submit" class="flex-1 cursor-pointer rounded-xl bg-indigo-600 py-2.5 text-sm font-medium text-white hover:bg-indigo-700">Cadastrar</button>
			</div>
		</form>
	</div>
}

templ CatalogoDetailBodyContent(catalog repository.ServiceCatalog, items []repository.Catalog, errorMessage string) {
	{{ groups := groupCatalogItems(items) }}
	<div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
		<a href={ templ.URL(fmt.Sprintf("/catalogo?project_id=%d", catalog.ProjectID)) } class="text-sm font-medium text-slate-500 no-underline hover:text-slate-800">← Voltar ao catálogo</a>
		<div class="mt-4 mb-8 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
			<div>
				<p class="text-xs font-semibold uppercase tracking-[0.14em] text-indigo-600">{ catalog.ProjectName }</p>
				<div class="mt-1 flex flex-wrap items-center gap-3">
					<h1 class="text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl">{ catalog.Name }</h1>
					if catalog.IsActive(time.Now()) {
						<span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-medium text-emerald-700">Vigente</span>
					} else {
						<span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-500">Fora do período</span>
					}
				</div>
				<p class="mt-2 text-sm text-slate-500">
					Vigência { formatDate(catalog.StartDate) } — { formatDate(catalog.EndDate) }
					<span class="mx-1.5 text-slate-300">·</span>
					<span id="catalog-count" class="font-medium text-slate-700">{ itemCountLabel(len(items)) }</span>
				</p>
			</div>
			if len(items) > 0 {
				<label class="relative w-full lg:max-w-sm">
					<span class="sr-only">Buscar no catálogo</span>
					<svg class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z"></path>
					</svg>
					<input
						id="catalog-search"
						type="search"
						placeholder="Buscar por código ou descrição"
						class="w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-10 pr-4 text-sm text-slate-800 shadow-sm outline-none placeholder:text-slate-400 focus:border-indigo-300 focus:ring-2 focus:ring-indigo-100"
					/>
				</label>
			}
		</div>

		if errorMessage != "" {
			<div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{ errorMessage }</div>
		}

		<section id="catalog-item-form-card" class="mb-8 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
			<h2 id="catalog-item-form-title" class="text-sm font-semibold text-slate-800">Novo item</h2>
			<p id="catalog-item-form-hint" class="mt-1 text-xs text-slate-500">Inclua um serviço com código, descrição e valores em UST. Para alterar um existente, use Editar na linha.</p>
			<form id="catalog-item-form" action="/catalogs/items/create" method="POST" class="mt-4 grid gap-3 sm:grid-cols-12">
				<input type="hidden" name="catalog_id" value={ fmt.Sprintf("%d", catalog.ID) }/>
				<input type="hidden" name="item_id" id="item_id" value=""/>
				<div class="sm:col-span-2">
					<label for="cod" class="mb-1 block text-xs font-medium text-slate-600">Código</label>
					<input id="cod" name="cod" type="text" required placeholder="COD01" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm shadow-sm outline-none placeholder:text-slate-400 focus:border-indigo-300 focus:ring-2 focus:ring-indigo-100"/>
				</div>
				<div class="sm:col-span-5">
					<label for="description" class="mb-1 block text-xs font-medium text-slate-600">Descrição</label>
					<input id="description" name="description" type="text" required placeholder="Descrição do serviço" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm shadow-sm outline-none placeholder:text-slate-400 focus:border-indigo-300 focus:ring-2 focus:ring-indigo-100"/>
				</div>
				<div class="sm:col-span-2">
					<label for="ust_normal" class="mb-1 block text-xs font-medium text-slate-600">UST Normal</label>
					<input id="ust_normal" name="ust_normal" type="number" min="0" required placeholder="0" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm shadow-sm outline-none focus:border-indigo-300 focus:ring-2 focus:ring-indigo-100"/>
				</div>
				<div class="sm:col-span-2">
					<label for="ust_new_tech" class="mb-1 block text-xs font-medium text-slate-600">UST New Tech</label>
					<input id="ust_new_tech" name="ust_new_tech" type="number" min="0" placeholder="Opcional" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm shadow-sm outline-none placeholder:text-slate-400 focus:border-indigo-300 focus:ring-2 focus:ring-indigo-100"/>
				</div>
				<div class="flex items-end gap-2 sm:col-span-1">
					<button id="catalog-item-submit" type="submit" class="w-full cursor-pointer rounded-xl bg-indigo-600 px-3 py-2 text-sm font-medium text-white hover:bg-indigo-700">Incluir</button>
				</div>
			</form>
			<button
				id="catalog-item-cancel"
				type="button"
				class="mt-3 hidden cursor-pointer text-sm font-medium text-slate-500 hover:text-slate-800"
			>
				Cancelar edição
			</button>
		</section>

		if len(items) == 0 {
			<div class="rounded-xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center">
				<p class="text-sm font-medium text-slate-700">Este catálogo ainda não tem itens.</p>
				<p class="mt-1 text-sm text-slate-500">Use o formulário acima para começar a incluir os serviços.</p>
			</div>
		} else {
			<div class="mb-6 flex gap-2 overflow-x-auto pb-1">
				<button
					type="button"
					data-catalog-filter="all"
					class="catalog-filter is-active shrink-0 cursor-pointer rounded-full border border-slate-900 bg-slate-900 px-3.5 py-1.5 text-sm font-medium text-white"
				>
					Todos
				</button>
				for _, group := range groups {
					<button
						type="button"
						data-catalog-filter={ group.Prefix }
						class="catalog-filter shrink-0 cursor-pointer rounded-full border border-slate-200 bg-white px-3.5 py-1.5 text-sm font-medium text-slate-600 hover:border-slate-300 hover:text-slate-900"
					>
						{ group.Name }
						<span class="ml-1 text-slate-400">{ fmt.Sprintf("%d", len(group.Items)) }</span>
					</button>
				}
			</div>

			<div id="catalog-empty" class="hidden rounded-xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center">
				<p class="text-sm font-medium text-slate-700">Nenhum serviço corresponde à busca.</p>
			</div>

			<div class="space-y-5">
				for _, group := range groups {
					<section data-catalog-group={ group.Prefix } class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
						<div class="flex items-center justify-between border-b border-slate-100 bg-slate-50/80 px-5 py-3">
							<div class="flex items-center gap-2.5">
								<span class="h-2 w-2 rounded-full bg-indigo-500"></span>
								<h2 class="text-sm font-semibold text-slate-800">{ group.Name }</h2>
							</div>
							<span class="text-xs font-medium text-slate-500">{ itemCountLabel(len(group.Items)) }</span>
						</div>
						<div class="overflow-x-auto">
							<table class="w-full min-w-[640px] border-collapse">
								<thead>
									<tr class="border-b border-slate-100 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-500">
										<th class="w-16 px-5 py-2.5">ID</th>
										<th class="w-28 px-5 py-2.5">Código</th>
										<th class="px-5 py-2.5">Descrição</th>
										<th class="w-28 px-5 py-2.5 text-right whitespace-nowrap">UST Normal</th>
										<th class="w-32 px-5 py-2.5 text-right whitespace-nowrap">UST New Tech</th>
										<th class="w-20 px-5 py-2.5 text-right">Ação</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-slate-100">
									for _, item := range group.Items {
										<tr
											data-catalog-row={ strings.ToLower(item.Cod + " " + item.Description + " " + group.Name) }
											data-item-id={ fmt.Sprintf("%d", item.ID) }
											data-item-cod={ item.Cod }
											data-item-description={ item.Description }
											data-item-ust-normal={ fmt.Sprintf("%d", item.UstNormal) }
											data-item-ust-new-tech={ fmt.Sprintf("%d", item.UstNewTech) }
											class="hover:bg-slate-50/80"
										>
											<td class="px-5 py-3.5 text-sm tabular-nums text-slate-400">{ fmt.Sprintf("%d", item.ID) }</td>
											<td class="px-5 py-3.5">
												<span class="inline-flex rounded-md bg-slate-100 px-2 py-0.5 font-mono text-xs font-semibold text-slate-800">{ item.Cod }</span>
											</td>
											<td class="px-5 py-3.5 text-sm leading-relaxed text-slate-600">{ item.Description }</td>
											<td class="px-5 py-3.5 text-right text-sm font-medium tabular-nums text-slate-900">{ formatUST(item.UstNormal) }</td>
											<td class="px-5 py-3.5 text-right text-sm font-medium tabular-nums text-indigo-700">{ formatUST(item.UstNewTech) }</td>
											<td class="px-5 py-3.5 text-right">
												<button
													type="button"
													class="catalog-item-edit cursor-pointer text-sm font-medium text-indigo-600 hover:text-indigo-800"
												>
													Editar
												</button>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</section>
				}
			</div>
		}
	</div>
}

func formatDate(value time.Time) string {
	return value.Format("02/01/2006")
}

func itemCountLabel(count int) string {
	if count == 1 {
		return "1 item"
	}
	return fmt.Sprintf("%d itens", count)
}

func catalogPrefix(cod string) string {
	end := 0
	for end < len(cod) {
		c := cod[end]
		if c < 'A' || c > 'Z' {
			break
		}
		end++
	}
	if end == 0 {
		return "OUT"
	}
	return cod[:end]
}

func catalogCategoryName(prefix string) string {
	switch prefix {
	case "ARQ":
		return "Arquitetura"
	case "COD":
		return "Codificação"
	case "DAD":
		return "Dados"
	case "ENC":
		return "Encontros"
	case "EST":
		return "Estudos"
	case "HIS":
		return "Histórias"
	case "MAN":
		return "Manuais"
	case "PROT":
		return "Protótipos"
	case "TES":
		return "Testes"
	case "VER":
		return "Versionamento"
	default:
		return prefix
	}
}

func groupCatalogItems(items []repository.Catalog) []catalogGroup {
	order := make([]string, 0)
	byPrefix := make(map[string][]repository.Catalog)
	for _, item := range items {
		prefix := catalogPrefix(item.Cod)
		if _, exists := byPrefix[prefix]; !exists {
			order = append(order, prefix)
		}
		byPrefix[prefix] = append(byPrefix[prefix], item)
	}

	groups := make([]catalogGroup, 0, len(order))
	for _, prefix := range order {
		groups = append(groups, catalogGroup{
			Prefix: prefix,
			Name:   catalogCategoryName(prefix),
			Items:  byPrefix[prefix],
		})
	}
	return groups
}

func formatUST(value int) string {
	if value == 0 {
		return "—"
	}
	return fmt.Sprintf("%d", value)
}
