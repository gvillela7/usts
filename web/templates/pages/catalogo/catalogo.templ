package catalogo

import (
	"github.com/gvillela7/usts/internal/repository"
	"fmt"
)

templ MetaTagsCatalogo(keywords, description string) {
	<meta name="keywords" content={ keywords }/>
	<meta name="description" content={ description }/>
}

templ CatalogoBodyContent(catalogs []repository.Catalog) {
	<div class="container mx-auto p-6">
		<h1 class="text-3xl font-bold mb-6">Catálogo de Serviços</h1>

		if len(catalogs) == 0 {
			<div class="alert alert-info">
				<span>Nenhum item encontrado no catálogo.</span>
			</div>
		} else {
			<div class="overflow-x-auto">
				<table class="min-w-full bg-white border border-gray-200 rounded-lg">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-3 py-2 text-left text-xs font-medium text-gray-600">ID</th>
							<th class="px-3 py-2 text-left text-xs font-medium text-gray-600">Código</th>
							<th class="px-3 py-2 text-left text-xs font-medium text-gray-600">Descrição</th>
							<th class="px-3 py-2 text-right text-xs font-medium text-gray-600">UST Normal</th>
							<th class="px-3 py-2 text-right text-xs font-medium text-gray-600">UST New Tech</th>
						</tr>
					</thead>
					<tbody>
						for _, catalog := range catalogs {
							<tr class="border-t border-gray-200">
								<td class="px-3 py-2 text-sm text-gray-900">{ fmt.Sprintf("%d", catalog.ID) }</td>
								<td class="px-3 py-2 text-sm font-semibold text-gray-900">{ catalog.Cod }</td>
								<td class="px-3 py-2 text-sm text-gray-600">{ catalog.Description }</td>
								<td class="px-3 py-2 text-sm text-right text-gray-900">{ fmt.Sprintf("%d", catalog.UstNormal) }</td>
								<td class="px-3 py-2 text-sm text-right text-gray-900">{ fmt.Sprintf("%d", catalog.UstNewTech) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}
