package os

templ OSTable() {
	<div id="os-items-container">
		<div id="os-items-table" class="hidden">
			<div class="overflow-x-auto rounded-xl border border-slate-200">
				<table class="os-items-grid w-full min-w-[1280px] border-collapse bg-white text-sm">
					<thead class="bg-slate-50">
						<tr class="border-b border-slate-200">
							<th class="w-12 px-2 py-3"></th>
							<th class="w-24 px-3 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Código</th>
							<th class="min-w-[280px] px-3 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Descrição</th>
							<th class="w-40 px-3 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Tipo</th>
							<th class="w-20 px-2 py-3 text-center text-xs font-semibold uppercase tracking-wide text-slate-500">UST</th>
							<th class="w-16 px-2 py-3 text-center text-xs font-semibold uppercase tracking-wide text-slate-500">Rec.</th>
							<th class="w-16 px-2 py-3 text-center text-xs font-semibold uppercase tracking-wide text-slate-500">Comp.</th>
							<th class="w-20 px-2 py-3 text-center text-xs font-semibold uppercase tracking-wide text-slate-500">UST Final</th>
							<th class="min-w-[220px] px-3 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Observação</th>
							<th class="w-28 px-3 py-3 text-center text-xs font-semibold uppercase tracking-wide text-slate-500">Candidata</th>
							<th class="w-14 px-2 py-3 text-center text-xs font-semibold uppercase tracking-wide text-slate-500">Ações</th>
						</tr>
					</thead>
					<tbody id="os-items-tbody" class="divide-y divide-slate-100">
					</tbody>
				</table>
			</div>
			<p class="mt-2 text-xs text-slate-400">Role horizontalmente se precisar ver todas as colunas.</p>
		</div>
	</div>
}
