package sprints

import (
	"github.com/gvillela7/usts/internal/repository"
	"github.com/gvillela7/usts/web/templates/components"
	"fmt"
)

templ MetaTagsSprints(keywords, description string) {
	<meta name="keywords" content={ keywords }/>
	<meta name="description" content={ description }/>
}

templ SprintsBodyContentWithTasks(projectsWithSprints []ProjectWithSprints) {
	<div class="container mx-auto p-6">
		<h1 class="text-3xl font-bold mb-6">Sprints</h1>
		if len(projectsWithSprints) == 0 {
			<div class="alert alert-info">
				<span>Nenhuma sprint encontrada. Crie sprints a partir da página de projetos.</span>
			</div>
		} else {
			<div class="space-y-6">
				for _, projectData := range projectsWithSprints {
					@projectSprintsSectionWithCollapse(projectData)
				}
			</div>
		}
		<!-- Edit Sprint Modal -->
		@EditSprintModal()
		<!-- Edit Project Modal -->
		@EditProjectModal()
	</div>
}

templ projectSprintsSectionWithCollapse(projectData ProjectWithSprints) {
	<div class="mb-4">
		<!-- Project Header -->
		<div class="flex items-center justify-between mb-3">
			<div class="flex items-center gap-2">
				<h2 class="text-xl font-medium">{ projectData.Project.Name }</h2>
				<span class="badge badge-primary">{ fmt.Sprintf("%d sprints", len(projectData.Sprints)) }</span>
				<svg
					class="w-4 h-4 text-gray-600 hover:text-blue-600 cursor-pointer inline-block"
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 20 20"
					fill="currentColor"
					onclick={ editProjectHandler(projectData.Project.ID, projectData.Project.Name) }
					title="Editar projeto"
				>
					<path d="M2.695 14.763l-1.262 3.154a.5.5 0 00.65.65l3.155-1.262a4 4 0 001.343-.885L17.5 5.5a2.121 2.121 0 00-3-3L3.58 13.42a4 4 0 00-.885 1.343z"></path>
				</svg>
			</div>
		</div>
		<!-- Sprint Collapses -->
		<div class="join join-vertical w-full">
			for _, sprintWithTasks := range projectData.Sprints {
				@sprintCollapseItem(sprintWithTasks)
			}
		</div>
	</div>
}

templ sprintCollapseItem(sprintData SprintWithTasks) {
	<div class="collapse collapse-arrow join-item border border-gray-200 bg-white">
		<input type="checkbox" name={ fmt.Sprintf("sprint-collapse-%d", sprintData.Sprint.ID) }/>
		<!-- Collapse Title (Sprint Name + Info) -->
		<div class="collapse-title text-md font-semibold bg-white">
			<div class="flex items-center justify-between">
				<div class="flex items-center gap-3">
					<span class="badge badge-sm">ID: { fmt.Sprintf("%d", sprintData.Sprint.ID) }</span>
					<span>{ sprintData.Sprint.Name }</span>
					<span class="badge badge-info badge-sm">{ fmt.Sprintf("%d tarefas", len(sprintData.Tasks)) }</span>
				</div>
				<div class="flex items-center gap-2">
					<span class="text-xs text-gray-500">{ sprintData.Sprint.CreatedAt.Format("02/01/2006") }</span>
					<svg
						class="w-4 h-4 text-gray-600 hover:text-blue-600 cursor-pointer"
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 20 20"
						fill="currentColor"
						onclick={ editSprint(sprintData.Sprint.ID, sprintData.Sprint.Name) }
						title="Editar sprint"
					>
						<path d="M2.695 14.763l-1.262 3.154a.5.5 0 00.65.65l3.155-1.262a4 4 0 001.343-.885L17.5 5.5a2.121 2.121 0 00-3-3L3.58 13.42a4 4 0 00-.885 1.343z"></path>
					</svg>
				</div>
			</div>
		</div>
		<!-- Collapse Content (Tasks List) -->
		<div class="collapse-content bg-white">
			if len(sprintData.Tasks) == 0 {
				<div class="text-sm text-gray-500 italic py-2">
					Nenhuma tarefa nesta sprint
				</div>
			} else {
				<div class="overflow-x-auto">
					<table class="min-w-full bg-white border border-gray-200 rounded-lg">
						<thead class="bg-gray-50">
							<tr>
								<th class="px-3 py-2 text-left text-xs font-medium text-gray-600">ID</th>
								<th class="px-3 py-2 text-left text-xs font-medium text-gray-600">Nome da Tarefa</th>
								<th class="px-3 py-2 text-left text-xs font-medium text-gray-600">Data de Criação</th>
							</tr>
						</thead>
						<tbody>
							for _, task := range sprintData.Tasks {
								<tr class="border-t border-gray-200">
									<td class="px-3 py-2 text-sm text-gray-900">{ fmt.Sprintf("%d", task.ID) }</td>
									<td class="px-3 py-2 text-sm text-gray-900">
										<a
											href={ templ.URL(fmt.Sprintf("/sprints/detail?id=%d", task.ID)) }
											class="text-blue-600 hover:text-blue-800 hover:underline font-medium"
										>
											{ task.Name }
										</a>
									</td>
									<td class="px-3 py-2 text-sm text-gray-600">{ task.CreatedAt.Format("02/01/2006 15:04") }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	</div>
}

script editSprint(sprintID int, sprintName string) {
	document.getElementById('edit-sprint-id').value = sprintID;
	document.getElementById('edit-sprint-name').value = sprintName;
	document.getElementById('edit-sprint-modal').showModal();
}

script editProjectHandler(projectID int, projectName string) {
	document.getElementById('edit-project-id').value = projectID;
	document.getElementById('edit-project-name').value = projectName;
	document.getElementById('edit-project-modal').showModal();
}

templ EditSprintHiddenFields() {
	<input type="hidden" id="edit-sprint-id" name="sprint_id"/>
}

templ EditSprintModal() {
	@components.Modal(
		"edit-sprint-modal",
		"Editar Sprint",
		"Nome da Sprint",
		"sprint_name",
		"edit-sprint-name",
		"Digite o novo nome da sprint",
		"Salvar",
		"/sprints/update",
		"#edit-sprint-message",
		EditSprintHiddenFields(),
	)
}

templ EditProjectHiddenFields() {
	<input type="hidden" id="edit-project-id" name="project_id"/>
}

templ EditProjectModal() {
	@components.Modal(
		"edit-project-modal",
		"Editar Projeto",
		"Nome do Projeto",
		"project_name",
		"edit-project-name",
		"Digite o novo nome do projeto",
		"Salvar",
		"/projects/update",
		"#edit-project-message",
		EditProjectHiddenFields(),
	)
}

templ MetaTagsSprintDetail(keywords, description string) {
	<meta name="keywords" content={ keywords }/>
	<meta name="description" content={ description }/>
}

templ MetaTagsTaskDetail(keywords, description string) {
	<meta name="keywords" content={ keywords }/>
	<meta name="description" content={ description }/>
}

templ TaskDetailBodyContent(task *repository.Task, project *repository.Project, osList []repository.OSWithCatalog) {
	<div class="container mx-auto p-6">
		<!-- Header with back button -->
		<div class="mb-6">
			<div class="flex justify-between items-start">
				<div class="flex-1">
					<a href="/sprints" class="btn btn-sm btn-ghost mb-4">
						<svg class="w-4 h-4 mr-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
							<path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"></path>
						</svg>
						Voltar para Sprints
					</a>
					<h1 class="text-3xl font-bold">{ task.Name }</h1>
					<p class="text-gray-600 mt-2">Projeto: <span class="font-semibold">{ project.Name }</span></p>
					<p class="text-gray-500 text-sm">Criada em: { task.CreatedAt.Format("02/01/2006 15:04") }</p>
				</div>
				if len(osList) > 0 {
					<div class="flex-shrink-0">
						<button
							onclick={ exportToExcel(task.ID, task.Name, project.Name, task.CreatedAt.Format("2006-01-02")) }
							class="btn btn-primary btn-sm gap-2"
							title="Exportar para Excel"
						>
							<svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
							</svg>
							Exportar Excel
						</button>
					</div>
				}
			</div>
		</div>

		<!-- OS List -->
		if len(osList) == 0 {
			<div class="alert alert-info">
				<span>Nenhuma OS encontrada para esta tarefa.</span>
			</div>
		} else {
			<div class="mb-4">
				<h2 class="text-xl font-semibold mb-3">Ordens de Serviço ({ fmt.Sprintf("%d", len(osList)) })</h2>
				<div class="overflow-x-auto">
					<table id="sprint-os-table" class="min-w-full bg-white border border-gray-200 rounded-lg">
						<thead class="bg-gray-50">
							<tr>
								<th class="px-3 py-2 text-left text-xs font-medium text-gray-600">ID</th>
								<th class="px-3 py-2 text-left text-xs font-medium text-gray-600">Código Catálogo</th>
								<th class="px-3 py-2 text-left text-xs font-medium text-gray-600">Descrição Catálogo</th>
								<th class="px-3 py-2 text-left text-xs font-medium text-gray-600">Descrição OS</th>
								<th class="px-3 py-2 text-left text-xs font-medium text-gray-600">Tipo</th>
								<th class="px-3 py-2 text-center text-xs font-medium text-gray-600">UST Item</th>
								<th class="px-3 py-2 text-center text-xs font-medium text-gray-600">UST Recorrência</th>
								<th class="px-3 py-2 text-center text-xs font-medium text-gray-600">Complexidade</th>
								<th class="px-3 py-2 text-center text-xs font-medium text-gray-600">UST Final</th>
								<th class="px-3 py-2 text-center text-xs font-medium text-gray-600">Tarefa Candidata</th>
								<th class="px-3 py-2 text-left text-xs font-medium text-gray-600">Data de Criação</th>
							</tr>
						</thead>
						<tbody>
							for _, osItem := range osList {
								<tr class="border-t border-gray-200 hover:bg-gray-50">
									<td class="px-3 py-2 text-sm text-gray-900">{ fmt.Sprintf("%d", osItem.OS.ID) }</td>
									<td class="px-3 py-2 text-sm font-medium text-blue-600">{ osItem.CatalogCod }</td>
									<td class="px-3 py-2 text-sm text-gray-700">{ osItem.CatalogDescription }</td>
									<td class="px-3 py-2 text-sm text-gray-900">{ osItem.OS.Description }</td>
									<td class="px-3 py-2 text-sm">
										<span class={ "badge", getBadgeClass(osItem.OS.Kind) }>{ osItem.OS.Kind }</span>
									</td>
									<td class="px-3 py-2 text-sm text-center text-gray-900">{ fmt.Sprintf("%d", osItem.OS.USTItem) }</td>
									<td class="px-3 py-2 text-sm text-center text-gray-900">{ fmt.Sprintf("%d", osItem.OS.USTRecurrence) }</td>
									<td class="px-3 py-2 text-sm text-center">
										<span class={ "badge", getComplexityBadgeClass(osItem.OS.Complexity) }>{ fmt.Sprintf("%d", osItem.OS.Complexity) }</span>
									</td>
									<td class="px-3 py-2 text-sm text-center font-semibold text-gray-900">
										if osItem.OS.USTEnd != nil {
											{ fmt.Sprintf("%d", *osItem.OS.USTEnd) }
										} else {
											-
										}
									</td>
									<td class="px-3 py-2 text-sm text-center">
										if osItem.OS.TarefaCandidta == 1 {
											<span class="badge badge-success">Sim</span>
										} else {
											<span class="badge badge-ghost">Não</span>
										}
									</td>
									<td class="px-3 py-2 text-sm text-gray-600">{ osItem.OS.CreatedAt.Format("02/01/2006 15:04") }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>

				<!-- Summary Section -->
				<div class="mt-6 bg-blue-50 p-4 rounded-lg border border-blue-200">
					<h3 class="text-lg font-semibold mb-2">Resumo</h3>
					<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
						<div>
							<p class="text-sm text-gray-600">Total de OS</p>
							<p class="text-2xl font-bold text-blue-600">{ fmt.Sprintf("%d", len(osList)) }</p>
						</div>
						<div>
							<p class="text-sm text-gray-600">UST Total</p>
							<p class="text-2xl font-bold text-blue-600">{ fmt.Sprintf("%d", calculateTotalUST(osList)) }</p>
						</div>
						<div>
							<p class="text-sm text-gray-600">Tarefas Candidatas</p>
							<p class="text-2xl font-bold text-blue-600">{ fmt.Sprintf("%d", countTarefasCandidatas(osList)) }</p>
						</div>
					</div>
				</div>
			</div>
		}
	</div>
}

func getBadgeClass(kind string) string {
	switch kind {
	case "Nova Funcionalidade":
		return "badge-primary"
	case "Melhoria":
		return "badge-info"
	case "Correção":
		return "badge-warning"
	case "Refatoração":
		return "badge-secondary"
	default:
		return "badge-ghost"
	}
}

func getComplexityBadgeClass(complexity int) string {
	if complexity <= 3 {
		return "badge-success"
	} else if complexity <= 7 {
		return "badge-warning"
	}
	return "badge-error"
}

func calculateTotalUST(osList []repository.OSWithCatalog) int {
	total := 0
	for _, osItem := range osList {
		if osItem.OS.USTEnd != nil {
			total += *osItem.OS.USTEnd
		}
	}
	return total
}

func countTarefasCandidatas(osList []repository.OSWithCatalog) int {
	count := 0
	for _, osItem := range osList {
		if osItem.OS.TarefaCandidta == 1 {
			count++
		}
	}
	return count
}

script exportToExcel(taskID int, taskName string, projectName string, deliveryDate string) {
	// Coletar dados da tabela
	const osData = [];
	const tableRows = document.querySelectorAll('#sprint-os-table tbody tr');

	tableRows.forEach((row) => {
		const cells = row.querySelectorAll('td');
		if (cells.length >= 11) {
			// Extrair badge text corretamente
			const kindBadge = cells[4].querySelector('.badge');
			const complexityBadge = cells[7].querySelector('.badge');
			const tarefaCandidataBadge = cells[9].querySelector('.badge');

			const osItem = {
				catalogCod: cells[1].textContent.trim(),
				catalogDescription: cells[2].textContent.trim(),
				description: cells[3].textContent.trim(),
				kind: kindBadge ? kindBadge.textContent.trim() : '',
				ustItem: parseInt(cells[5].textContent.trim()) || 0,
				ustRecurrence: parseInt(cells[6].textContent.trim()) || 0,
				complexity: complexityBadge ? parseInt(complexityBadge.textContent.trim()) : 0,
				ustEnd: cells[8].textContent.trim() === '-' ? 0 : parseInt(cells[8].textContent.trim()) || 0,
				tarefaCandidta: tarefaCandidataBadge && tarefaCandidataBadge.textContent.trim() === 'Sim' ? 1 : 0
			};
			osData.push(osItem);
		}
	});

	// Chamar função de exportação
	if (window.exportTaskToExcel) {
		window.exportTaskToExcel(taskID, taskName, projectName, osData, deliveryDate);
	} else {
		console.error('Função de exportação não disponível');
	}
}
