package pages

import (
	"fmt"

	"github.com/gvillela7/usts/internal/repository"
	)

// MetaTags defines meta tags.

templ MetaTags(keywords, description string) {
	<meta name="keywords" content={ keywords }/>
	<meta name="description" content={ description }/>
}

// styledTextStyles defines CSS styles for component.

css styledTextStyles() {
	color: #02BF87;
}

// BodyContent defines HTML content.

templ BodyContent(h1, text string, projects []repository.Project, selected *repository.Project, errorMessage string) {
	<div class="w-full min-h-[calc(100vh-3.5rem)] lg:min-h-screen bg-slate-50 flex flex-col items-center justify-center p-4 sm:p-6">
		<div class="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
			<div class="mb-6 text-center">
				<div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
					<svg class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
						<path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"></path>
					</svg>
				</div>
				<h1 class="text-2xl font-semibold tracking-tight text-slate-900">{ h1 }</h1>
				<p class="mt-2 text-sm text-slate-500">{ text }</p>
			</div>

			<div id="message-area" class="mb-4">
				if errorMessage != "" {
					<div class="flex items-center rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
						{ errorMessage }
					</div>
				}
			</div>

			<div>
				<label for="project-select" class="mb-2 block text-sm font-medium text-slate-700">Selecione o projeto</label>
				<select
					id="project-select"
					name="project_id"
					onchange={ openSelectedProject() }
					class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200"
				>
					<option value="" selected>Selecione um projeto...</option>
					for _, p := range projects {
						<option value={ templ.EscapeString(fmt.Sprintf("%d", p.ID)) }>{ p.Name }</option>
					}
				</select>
			</div>
		</div>
	</div>
}

script openSelectedProject() {
	const select = document.getElementById('project-select');
	const id = select?.value;
	const messageArea = document.getElementById('message-area');
	if (!id) {
		if (messageArea && window.createAlert) {
			messageArea.innerHTML = window.createAlert('warning', 'Selecione um projeto antes de continuar.');
		}
		return;
	}
	window.location.href = '/sprints?project_id=' + encodeURIComponent(id);
}

script BodyScripts() {
}
